{
  "name": "immca",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && tsx scripts/build-feeds.ts && tsx scripts/build-sw.ts",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "refresh:draws": "node scripts/refresh-draws.mjs",
    "sources:check": "tsx scripts/check-sources.ts",
    "sources:accept": "tsx scripts/check-sources.ts --accept",
    "log:update": "tsx scripts/log-update.ts",
    "readme:assets": "node scripts/readme-assets.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.62.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "ical.js": "^2.2.1",
    "jsdom": "^30.1.3",
    "oxlint": "^1.89.0",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "description": "Browser-only screener for Canadian immigration pathways: federal, Québec and provincial programs, sourced and trilingual.",
  "author": "Ziyi Zhou",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/EllenSyuu/IMMCA"
  }
}
